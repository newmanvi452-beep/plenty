# Copy to .env.local and fill in (Supabase: Project Settings > API). Leave both empty to run without sharing.
# The anon key is meant to be public; the database functions in supabase/schema.sql control access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# How the sign-in email works. Leave unset for "link" (Supabase's built-in emails send a sign-in link).
# Set to "code" only after you add your own email provider (SMTP) and put {{ .Token }} in the email template.
VITE_AUTH_METHOD=
